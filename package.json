{
	"name": "sveltes-stash-demo",
	"version": "1.0.0",
	"description": "Demo of svelte-stash",
	"author": "Atif C <atifcdev@gmail.com>",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atif-c/svelte-stash-demo.git"
	},
	"bugs": {
		"url": "https://github.com/atif-c/svelte-stash-demo/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"eslint:check": "eslint .",
		"eslint:fix": "eslint --fix .",
		"format": "prettier --write . && eslint --fix .",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@atifc/css": "^1.0.3",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.3",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"svelte-stash": "^1.0.0"
	}
}
